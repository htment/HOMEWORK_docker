  - job_name: 'node_exporter_192.168.31.116'
    honor_labels: true
    static_configs:
      - targets: ["192.168.31.116:9100"]

  - job_name: 'procecc_exporer_192.168.31.116'
    honor_labels: true
    static_configs:
