  - job_name: 'pushgateway'
    honor_labels: true
    static_configs:
      - targets: ["pushgateway:9091"]

  - job_name: 'alertmanager'
    honor_labels: true
    static_configs:
      - targets: ["alertmanager:9093"]

  - job_name: '192.168.31.44_smart'
    honor_labels: true
    static_configs:
      - targets: ["192.168.31.44:9902"]

  - job_name: "nSMART_exporter_192.168.31.44"
    # metrics_path defaults to '/metrics'
